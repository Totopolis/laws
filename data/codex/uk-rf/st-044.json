  "path": [
    "ОБЩАЯ ЧАСТЬ",
    "Раздел III. НАКАЗАНИЕ",
    "ГЛАВА 9. ПОНЯТИЕ И ЦЕЛИ НАКАЗАНИЯ. ВИДЫ НАКАЗАНИЙ"
  ],
  "content": [
    {
      "text": "Видами наказаний являются:"
    },
    {
      "unit": "пункт",
      "number": "а",
      "text": "а) штраф;"
    },
    {
      "unit": "пункт",
      "number": "б",
      "text": "б) лишение права занимать определенные должности или заниматься определенной деятельностью;"
    },
    {
      "unit": "пункт",
      "number": "в",
      "text": "в) лишение специального, воинского или почетного звания, классного чина и государственных наград;"
    },
    {
      "unit": "пункт",
      "number": "г",
      "text": "г) обязательные работы;"
    },
    {
      "unit": "пункт",
      "number": "д",
      "text": "д) исправительные работы;"
    },
    {
      "unit": "пункт",
      "number": "е",
      "text": "е) ограничение по военной службе;"
    },
    {
      "unit": "пункт",
      "number": "ж",
      "status": "утратил силу",
      "text": "ж)"
    },
    {
      "unit": "пункт",
      "number": "з",
      "text": "з) ограничение свободы;"
    },
    {
      "unit": "пункт",
      "number": "з1",
      "text": "з1) принудительные работы;"
    },
    {
      "unit": "пункт",
      "number": "и",
      "text": "и) арест;"
    },
    {
      "unit": "пункт",
      "number": "к",
      "text": "к) содержание в дисциплинарной воинской части;"
    },
    {
      "unit": "пункт",
      "number": "л",
      "text": "л) лишение свободы на определенный срок;"
    },
    {
      "unit": "пункт",
      "number": "м",
      "text": "м) пожизненное лишение свободы;"
    },
    {
      "unit": "пункт",
      "number": "н",
      "text": "н) смертная казнь."
    }
  ]
}
