  "path": [
    "Раздел I. ОБЩИЕ ПОЛОЖЕНИЯ",
    "Глава 2. СИСТЕМА НАЛОГОВ И СБОРОВ В РОССИЙСКОЙ ФЕДЕРАЦИИ"
  ],
  "content": [
    {
      "text": "К федеральным налогам и сборам относятся:"
    },
    {
      "unit": "пункт",
      "number": "1",
      "text": "1) налог на добавленную стоимость;"
    },
    {
      "unit": "пункт",
      "number": "2",
      "text": "2) акцизы;"
    },
    {
      "unit": "пункт",
      "number": "3",
      "text": "3) налог на доходы физических лиц;"
    },
    {
      "unit": "пункт",
      "number": "4",
      "status": "утратил силу",
      "text": "4)"
    },
    {
      "unit": "пункт",
      "number": "5",
      "text": "5) налог на прибыль организаций;"
    },
    {
      "unit": "пункт",
      "number": "6",
      "text": "6) налог на добычу полезных ископаемых;"
    },
    {
      "unit": "пункт",
      "number": "7",
      "status": "утратил силу",
      "text": "7)"
    },
    {
      "unit": "пункт",
      "number": "8",
      "text": "8) водный налог;"
    },
    {
      "unit": "пункт",
      "number": "9",
      "text": "9) сборы за пользование объектами животного мира и за пользование объектами водных биологических ресурсов;"
    },
    {
      "unit": "пункт",
      "number": "10",
      "text": "10) государственная пошлина;"
    },
    {
      "unit": "пункт",
      "number": "11",
      "text": "11) налог на дополнительный доход от добычи углеводородного сырья;"
    },
    {
      "unit": "пункт",
      "number": "12",
      "text": "12) налог на сверхприбыль;"
    },
    {
      "unit": "пункт",
      "number": "13",
      "text": "13) налог на игорный бизнес."
    }
  ]
}
