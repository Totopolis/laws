  "path": [
    "Глава 3. Служба в Следственном комитете. Правовое положение сотрудников Следственного комитета"
  ],
  "content": [
    {
      "unit": "часть",
      "number": "1",
      "content": [
        {
          "text": "1. Сотрудникам Следственного комитета (кроме военнослужащих) присваиваются следующие специальные звания:"
        },
        {
          "unit": "пункт",
          "number": "1",
          "content": [
            {
              "text": "1) младшие специальные звания:"
            },
            {
              "unit": "подпункт",
              "number": "а",
              "text": "а) младший лейтенант юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "б",
              "text": "б) лейтенант юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "в",
              "text": "в) старший лейтенант юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "г",
              "text": "г) капитан юстиции;"
            }
          ]
        },
        {
          "unit": "пункт",
          "number": "2",
          "content": [
            {
              "text": "2) старшие специальные звания:"
            },
            {
              "unit": "подпункт",
              "number": "а",
              "text": "а) майор юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "б",
              "text": "б) подполковник юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "в",
              "text": "в) полковник юстиции;"
            }
          ]
        },
        {
          "unit": "пункт",
          "number": "3",
          "content": [
            {
              "text": "3) высшие специальные звания:"
            },
            {
              "unit": "подпункт",
              "number": "а",
              "text": "а) генерал-майор юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "б",
              "text": "б) генерал-лейтенант юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "в",
              "text": "в) генерал-полковник юстиции;"
            },
            {
              "unit": "подпункт",
              "number": "г",
              "text": "г) генерал юстиции Российской Федерации."
            }
          ]
        }
      ]
    },
    {
      "unit": "часть",
      "number": "2",
      "text": "2. Порядок присвоения специальных званий сотрудникам Следственного комитета определяется Президентом Российской Федерации."
    }
  ]
}
